{
  "name": "kube-observe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "npm run api:check && tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/lib/prometheus/*.test.ts",
    "api:generate": "openapi-typescript api/openapi.yaml -o src/generated/api.types.ts",
    "api:check": "openapi-typescript api/openapi.yaml -o src/generated/api.types.ts --check",
    "postbuild": "node scripts/prepare-standalone.mjs"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.87.0",
    "@copilotkit/react-ui": "^1.87.0",
    "@copilotkit/runtime": "^1.87.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
