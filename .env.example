PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
# Optional bearer token; only used on the server
PROMETHEUS_TOKEN=
# Set true explicitly to explore the interface with sample data
DEMO_MODE=false
# Required to receive Alertmanager webhook pushes. Use a long random secret.
ALERTMANAGER_WEBHOOK_TOKEN=
# PostgreSQL connection for unified Alertmanager alerts and Kubernetes Events (planned).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=operator_agent_service
DB_USER=operator_agent_service
DB_PASSWORD=
# OpenAI-compatible chat completions endpoint (server-side only)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional override for the network probe command allowlist
NETWORK_DIAGNOSTICS_CONFIG=
